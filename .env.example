# At least 32 characters. Signs the member session cookie.
TGI_SESSION_SECRET=

# Comma-separated emails that can release the next report.
TGI_STAFF_EMAILS=

# Optional. Sends confirmation mail through Resend. Without it, this Mac uses Mail.app.
RESEND_API_KEY=
# Optional. Google Workspace SMTP for cory@thegoatinitiative.org. Used before Resend when set.
TGI_SMTP_HOST=
TGI_SMTP_PORT=465
TGI_SMTP_USER=
TGI_SMTP_PASS=
# Mail.app must already have this account. The default is cory@thegoatinitiative.org.
TGI_MAIL_FROM=The GOAT Initiative <cory@thegoatinitiative.org>
# Set on Vercel when the private Blob store is connected. Leave blank locally.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
